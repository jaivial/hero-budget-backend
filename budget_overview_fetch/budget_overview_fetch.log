			WHERE b.user_id = ? AND (
			(b.recurring = 1 AND 
			 strftime('%Y-%m', b.start_date) <= ? AND 
			 strftime('%Y-%m', date(b.start_date, '+' || (b.duration_months - 1) || ' months')) >= ?) OR
			(b.recurring = 0 AND strftime('%Y-%m', b.due_date) = ?)
		) 
			ORDER BY COALESCE(bp.paid, 0) ASC, calculated_due_date ASC
