						strftime('%Y-%m-%d', 
							date('2025-06-01', '+' || (b.payment_day - 1) || ' days'))
					ELSE b.due_date 
				END as calculated_due_date,
				COALESCE(bp.paid, 0) as month_paid, 
				b.overdue, b.overdue_days, b.recurring, b.category, b.icon,
				b.start_date, b.duration_months, b.payment_day
