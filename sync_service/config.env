# HeroBudget Sync Service Configuration
# Variables de entorno para el servicio de sincronización offline

# Puerto en el que ejecutar el servicio
SYNC_SERVICE_PORT=8101

# Ruta a la base de datos principal
DATABASE_PATH=../budget_data.db

# Nivel de logging (debug, info, warn, error)
LOG_LEVEL=info

# Configuración de CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Configuración de timeout para operaciones de base de datos (en segundos)
DB_TIMEOUT=30

# Tamaño máximo de lote para sincronización
MAX_BATCH_SIZE=100

# Configuración de reintentos para operaciones fallidas
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5

# Configuración de limpieza de logs
LOG_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24